#!/home/alan/Documents/Repos/catpart-parser/.venv/bin/python
"""Historial de cambios en JSONL para disenos de partes CATIA (uso personal).

Para cada .CATPart/.CATProduct anade una fila JSONL solo cuando el
contenido del archivo (sha256) difiere del ultimo registro de esa ruta
--force fuerza el registro de un estado sin cambio. La caja envolvente
se obtiene del pool de vertices (G1+G2) sin crear geometria: ni
facetas, ni sopa de triangulos, ni PLY. Los productos y los archivos
sin store de geometria se registran con geometry:null y la clase de
error, para que el evento quede en el historial.

Uso:
  catpart-history --scan ~/disenos/CATIA --history ~/disenos/design-history.jsonl
  catpart-history FILE... [--force]

  FILE...                archivos .CATPart/.CATProduct sueltos
  --scan DIR             recorre DIR recursivamente (ambas extensiones,
                         case-insensitive); se combina con FILE...
  --history PATH         JSONL destino (default: ./design-history.jsonl)
  --force                registra tambien un estado sin cambio
                         (reason="forced")

Las rutas se deduplican por ruta absoluta resuelta; el diseno se
identifica por su ruta (renombrar/mover = diseno nuevo en el
historial; el document_name guardado por CATIA va en cada fila por si
se quiere re-agrupar al consumir).

Fila (una por linea, compacta, LF):
  {"schema_version":1,"recorded_at":...,"source_path":...,"file_sha256":...,
   "file_size":...,"file_mtime":...,"document_name":...|"null",
   "catia_version":...|"null",
   "geometry":{"bbox":{"min":[x,y,z],"max":[x,y,z]},"vertex_count":N,
               "pool_group_count":N,"composite_space":bool}|null,
   "error":{"class":"...","message":"..."}|null,
   "reason":"first"|"changed"|"forced"}

Cada fila es autocontenida (estado, no diff): el consumidor calcula
los cambios entre filas consecutivas del mismo source_path, p. ej.
  jq -s 'group_by(.source_path)' design-history.jsonl

Salvedades del bbox (pool completo):
- Puede SOBREESTIMAR: cuenta vertices del pool que ningun triangulo
  referenciado usa (el exportador los avisa como unused-pool-vertices).
  La caja ajustada requeriria escanear las referencias de facetas (sin
  crear geometria tambien, pero cuesta el escaneo G3).
- Es la caja de la teselada: acota la B-Rep real desde dentro, con
  error acotado por la tolerancia de teselado; no es la caja exacta
  que daria CATIA sobre la B-Rep.
- composite_space:true marca los stores cuyo espacio indice compuesto
  no esta decodificado (G3 F8, pregunta abierta 1): el pool decodifica
  y da un bbox, pero la completitud del pool no esta garantizada ahi.

El historial es append-only y falla cerrado: una linea corrupta aborta
la ejecucion con su numero de linea (nunca se salta en silencio).

Copias: la copia canonica vive en ~/.local/bin/catpart-history (con
este shebang apuntando al .venv de este repo); la copia en scripts/ es
respaldo a peticion del dueno (la herramienta se usa en otro proyecto).
"""

from __future__ import annotations

import argparse
import hashlib
import json
import mmap
import sys
from datetime import datetime, timezone
from pathlib import Path

from catpart.geometry import mesh, pool, store
from catpart.geometry.errors import ExportError
from catpart.identity import parse_document_name
from catpart.version import detect_version

SCHEMA_VERSION = 1
EXTENSIONS = (".catpart", ".catproduct")


def hash_file(path: Path) -> tuple[str, int, str]:
    """(sha256 hex, tamano, mtime UTC ISO) de ``path``."""
    h = hashlib.sha256()
    size = 0
    with path.open("rb") as fh:
        for chunk in iter(lambda: fh.read(1 << 20), b""):
            h.update(chunk)
            size += len(chunk)
    mtime = datetime.fromtimestamp(path.stat().st_mtime, tz=timezone.utc)
    return h.hexdigest(), size, mtime.isoformat(timespec="seconds")


def load_last_by_path(history_path: Path) -> dict[str, dict]:
    """Ultima fila por ``source_path``; falla cerrado en lineas corruptas."""
    try:
        text = history_path.read_text(encoding="utf-8")
    except FileNotFoundError:
        return {}
    last: dict[str, dict] = {}
    for lineno, line in enumerate(text.splitlines(), start=1):
        if not line.strip():
            continue
        try:
            row = json.loads(line)
            key = row["source_path"]
        except (json.JSONDecodeError, KeyError, TypeError) as exc:
            sys.exit(f"{history_path}:{lineno}: linea de historial invalida "
                     f"({exc}); corrigela a mano: el historial falla cerrado")
        last[key] = row
    return last


def pool_bbox(data) -> dict | None:
    """Caja del pool del primer store con pool decodificable (G1+G2).

    Devuelve ``None`` y la clase de error cuando el archivo no lleva
    store de geometria util (productos, stores vacios, pools rotos).
    Un store compuesto SI decodifica su pool: se marca ``composite_space``
    porque la completitud del pool no esta garantizada ahi (G3 F8 Q1).
    """
    size = len(data)
    if size == 0:
        raise ExportError("empty-file", "el archivo esta vacio")
    d8_outer = int.from_bytes(data[8:12], "big") if size >= 12 else 0
    blocks = store.valid_blocks(data)
    stdcont = [b for b, nm in blocks if nm == "CATStdCont"]
    if not stdcont:
        raise ExportError("missing-geometry-store",
                          "sin bloque CATStdCont (p.ej. un producto)")
    first_error: ExportError | None = None
    for blk in stdcont:
        try:
            span = store.locate_store(data, blk, blocks, d8_outer)
            if span is None:
                continue
            groups, kinds = pool.scan_pool_groups(
                data, span.body_lo, span.body_hi)
            if not groups:
                raise ExportError(
                    "no-pool", "store sin grupos de pool 01 06 decodificados")
        except ExportError as exc:
            if first_error is None:
                first_error = exc
            continue
        flat = [v for g in groups for v in g.vertices]
        bbox_min, bbox_max = mesh.bounding_box(flat)
        return {
            "bbox": {"min": bbox_min, "max": bbox_max},
            "vertex_count": len(flat),
            "pool_group_count": len(groups),
            "composite_space": pool.has_composite_space(kinds),
        }
    raise first_error if first_error else ExportError(
        "missing-geometry-store", "sin store anidado validado")


def build_row(path: Path, sha: str, size: int, mtime: str, reason: str) -> dict:
    """Una fila completa: identidad + geometria sin crearla."""
    with path.open("rb") as fh:
        data = mmap.mmap(fh.fileno(), 0, access=mmap.ACCESS_READ)
    try:
        document_name = parse_document_name(data)
        catia_version = detect_version(data)
        try:
            geometry = pool_bbox(data)
            error = None
        except ExportError as exc:
            geometry, error = None, {"class": exc.error_class, "message": exc.detail}
    finally:
        data.close()
    return {
        "schema_version": SCHEMA_VERSION,
        "recorded_at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "source_path": str(path.resolve()),
        "file_sha256": sha,
        "file_size": size,
        "file_mtime": mtime,
        "document_name": document_name,
        "catia_version": None if catia_version == "unknown" else catia_version,
        "geometry": geometry,
        "error": error,
        "reason": reason,
    }


def collect_files(args) -> list[Path]:
    """Archivos de los argumentos + --scan DIR, deduplicados y ordenados."""
    files: set[Path] = {Path(f) for f in args.files}
    if args.scan:
        files.update(
            p for p in args.scan.rglob("*")
            if p.is_file() and p.suffix.lower() in EXTENSIONS
        )
    return sorted(files, key=lambda p: str(p).lower())


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(
        prog="catpart-history",
        description="Historial de cambios JSONL (bbox sin crear geometria).")
    ap.add_argument("files", nargs="*", help="archivos .CATPart/.CATProduct")
    ap.add_argument("--scan", type=Path, help="directorio a recorrer recursivamente")
    ap.add_argument("--history", type=Path, default=Path("design-history.jsonl"),
                    help="JSONL destino (default: ./design-history.jsonl)")
    ap.add_argument("--force", action="store_true",
                    help="registrar tambien estados sin cambio (reason=forced)")
    args = ap.parse_args(argv)

    files = collect_files(args)
    if not files:
        ap.error("sin archivos: pasa FILE... o --scan DIR")
    if any(f.suffix.lower() not in EXTENSIONS for f in files):
        ap.error("todos los archivos deben ser .CATPart o .CATProduct")

    last_by_path = load_last_by_path(args.history)
    rows: list[dict] = []
    appended = skipped = errored = 0
    for f in files:
        try:
            sha, size, mtime = hash_file(f)
        except OSError as exc:
            print(f"ERROR   {f}: {exc}", file=sys.stderr)
            errored += 1
            continue
        key = str(f.resolve())
        prev = last_by_path.get(key)
        if prev is not None and prev["file_sha256"] == sha and not args.force:
            skipped += 1
            continue
        reason = "forced" if (prev is not None and prev["file_sha256"] == sha) else \
                 ("first" if prev is None else "changed")
        row = build_row(f, sha, size, mtime, reason)
        rows.append(row)
        last_by_path[key] = row
        appended += 1
        geo = row["geometry"]
        detail = (f"bbox {geo['vertex_count']}v" if geo
                  else f"error {row['error']['class']}")
        print(f"{reason.upper():7s} {f} [{detail}]")

    if rows:
        args.history.parent.mkdir(parents=True, exist_ok=True)
        with args.history.open("a", encoding="utf-8", newline="\n") as fh:
            for row in rows:
                fh.write(json.dumps(row, separators=(",", ":")) + "\n")
    print(f"{args.history}: {appended} anadidas, {skipped} sin cambio, "
          f"{errored} ilegibles, {len(files)} archivos")
    return 1 if errored else 0


if __name__ == "__main__":
    sys.exit(main())
